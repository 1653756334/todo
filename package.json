{
  "name": "code-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-23330}",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-23330}",
    "worker": "node --env-file-if-exists=.env dist/worker.mjs",
    "service": "./scripts/service.sh",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "hash-password": "node scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src worker --quiet",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin:init": "tsx --env-file=.env scripts/init-admin.ts",
    "test": "node --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.test --import ./test/setup.mjs --test --test-concurrency=1 test/*.test.ts",
    "test:ui": "node --env-file=.env scripts/product-ui-check.mjs",
    "worker:dev": "tsx --env-file=.env worker/main.ts",
    "worker:build": "esbuild worker/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker.mjs",
    "typecheck:worker": "tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-switch": "^1.3.8",
    "archiver": "^8.0.0",
    "bullmq": "^6.3.12",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^6.2.1",
    "smtp-server": "^3.19.20",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1"
  }
}
