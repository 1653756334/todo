DATABASE_URL=postgresql://todo:replace_me@127.0.0.1:25432/todo
POSTGRES_PASSWORD=replace_me
REDIS_URL=redis://127.0.0.1:26379
# Compose 项目名：决定容器与数据卷前缀，生产与测试用不同值隔离
COMPOSE_PROJECT_NAME=todo
# web 端口。走反向代理/隧道时，必须与隧道指向的端口一致
PORT=23330
# 公网地址：邮件与推送链接的前缀，同时决定 Cookie 是否带 Secure
APP_URL=http://localhost:23330
APP_SECRET=replace_with_random_32_bytes
ENCRYPTION_KEY=replace_with_random_32_bytes
TRUST_PROXY=false
MINIO_ENDPOINT=http://127.0.0.1:29000
MINIO_BUCKET=todo-private
MINIO_ROOT_USER=todo-storage-root
MINIO_ROOT_PASSWORD=replace_with_random_root_password
MINIO_ACCESS_KEY=todo-assets
MINIO_SECRET_KEY=replace_with_random_application_password
