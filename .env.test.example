# 测试环境配置：`npm test` 只认这个文件里的 TEST_*，不会连到 .env 里的应用库。
#
# 用法：cp .env.test.example .env.test 后按本机情况改；用 Compose 起基础设施时，
# ./scripts/service.sh infra-up 会自动建好测试库与测试桶并生成 .env.test。
#
# 数据库：库名必须以 _test 结尾，且不能与应用库相同，否则 npm test 拒绝运行。
TEST_DATABASE_URL=postgresql://todo:replace_me@127.0.0.1:25432/todo_test

# Redis：换一个库序号（应用用 /0，测试用 /1），避免测试作业被应用的 worker 取走。
TEST_REDIS_URL=redis://127.0.0.1:26379/1

# 对象存储桶：必须与应用桶不同，测试写入的临时对象不会进应用桶。
# 地址与访问密钥沿用 .env 的 MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY。
TEST_MINIO_BUCKET=todo-test
